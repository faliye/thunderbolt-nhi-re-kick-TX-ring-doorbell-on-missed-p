 	}
 	net->local_transmit_path = hopid;
+	netdev_info(dev, "TX HopID %d (burned %u)\n", hopid, burn_out_hopids);
 
 	sof_mask = BIT(TBIP_PDF_FRAME_START);
 	eof_mask = BIT(TBIP_PDF_FRAME_END);
