+	ring = tb_ring_alloc_tx(xd->tb->nhi, tx_ring_index, TBNET_RING_SIZE,
+				flags);
+	if (!ring && tx_ring_index >= 0) {
+		netdev_warn(dev, "TX ring %d busy, falling back to any\n",
+			    tx_ring_index);
+		ring = tb_ring_alloc_tx(xd->tb->nhi, -1, TBNET_RING_SIZE,
