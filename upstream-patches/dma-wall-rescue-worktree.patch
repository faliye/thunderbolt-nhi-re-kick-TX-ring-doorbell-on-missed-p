+			int b = tb_xdomain_alloc_out_hopid(xd, -1);
+
+			if (b < 0)
+				break;
+			burn[nburn++] = b;
+		}
+		hopid = tb_xdomain_alloc_out_hopid(xd, -1);
+		for (i = 0; i < nburn; i++)
+			tb_xdomain_release_out_hopid(xd, burn[i]);
+	} else {
+		hopid = tb_xdomain_alloc_out_hopid(xd, -1);
+	}
 	if (hopid < 0) {
 		netdev_err(dev, "failed to allocate Tx HopID\n");
 		tb_ring_free(net->tx_ring.ring);
